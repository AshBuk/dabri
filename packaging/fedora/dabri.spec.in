# Copyright (c) 2025 Asher Buk
# SPDX-License-Identifier: MIT
# https://github.com/AshBuk/dabri
#
# Named dabri.spec.in, not dabri.spec: Go >= 1.26.11 refuses to build a tree
# that holds a *.spec file while the whisper.cpp Go bindings link with -fopenmp
# (ggml-org/whisper.cpp#4169). Copy it to dabri.spec for rpmlint and rpmbuild.

%global goipath         github.com/AshBuk/dabri/v2
%global forgeurl        https://github.com/AshBuk/dabri
Version:                2.6.0
%global go_version      1.26
%global whisper_version 1.9.5

%gometa -L -f

# Keep the private libraries out of the package's provides and requires
%global __provides_exclude_from ^%{_libdir}/%{name}/.*$
%global __requires_exclude libwhisper\\.so|libparakeet\\.so|libggml.*\\.so

Name:           dabri
Release:        1%{?dist}
Summary:        Offline speech-to-text desktop application
# Generated by go-vendor-tools; the bundled C libraries are all MIT
License:        Apache-2.0 AND BSD-2-Clause AND BSD-3-Clause AND ISC AND MIT
URL:            %{gourl}

Source0:        %{gosource}
Source1:        %{archivename}-vendor.tar.bz2
Source2:        go-vendor-tools.toml
Source3:        https://github.com/ggml-org/whisper.cpp/archive/refs/tags/v%{whisper_version}.tar.gz#/whisper-cpp-%{whisper_version}.tar.gz

# Upstream builds and tests only these two
ExclusiveArch:  x86_64 aarch64

BuildRequires:  golang >= %{go_version}
BuildRequires:  go-vendor-tools
BuildRequires:  gcc
BuildRequires:  gcc-c++
BuildRequires:  cmake
BuildRequires:  make
BuildRequires:  pkgconfig
BuildRequires:  pkgconfig(gtk+-3.0)
BuildRequires:  pkgconfig(dbus-1)
BuildRequires:  vulkan-devel
BuildRequires:  glslc
# whisper.cpp's Vulkan backend needs the SPIRV-Headers cmake config
BuildRequires:  spirv-headers-devel
BuildRequires:  desktop-file-utils
BuildRequires:  appstream

Requires:       alsa-utils
# ffmpeg comes from RPM Fusion
Suggests:       ffmpeg
Requires:       xsel
Recommends:     wl-clipboard
# xdotool types on X11; Wayland uses ydotool or wtype
Requires:       xdotool
Recommends:     ydotool
Recommends:     wtype
Requires:       /usr/bin/notify-send
Requires:       gtk3
Requires:       dbus
# GPU acceleration; without it Dabri runs on the CPU
Recommends:     vulkan-loader

# Fedora's whisper-cpp has no Vulkan backend and builds without SIMD, and Fedora
# ships no ggml package, so dabri builds both from source.
Provides:       bundled(whisper-cpp) = %{whisper_version}
Provides:       bundled(ggml) = 0.26.0

%description
Dabri is a minimalist, privacy-focused desktop application for offline
speech-to-text. It converts voice input directly into any active window
(editors, browsers, IDEs, AI assistants) using Whisper or NVIDIA Parakeet
models locally.

Features:
- Offline speech-to-text with local processing (privacy-first)
- Cross-platform support for X11 and Wayland
- Native integration with GNOME, KDE, and other Linux DEs
- Voice typing or clipboard mode
- Flexible audio recording (ALSA or PulseAudio/PipeWire)
- Multi-language support, custom hotkey binding

The Whisper small-q5_1 model (~181 MB) is downloaded on first run.

%prep
%goprep -p1
tar -xf %{SOURCE1}

mkdir -p build
tar -xzf %{SOURCE3} -C build
mv build/whisper.cpp-%{whisper_version} build/whisper.cpp
# Licenses of the bundled C libraries, installed by %%go_vendor_license_install
cp -p build/whisper.cpp/LICENSE LICENSE.whisper

%generate_buildrequires
%go_vendor_license_buildrequires -c %{SOURCE2}

%build
%set_build_flags
WHISPER_RPATH='%{_libdir}/%{name}'

pushd build/whisper.cpp
cmake -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_SHARED_LIBS=ON \
    -DCMAKE_INSTALL_RPATH="$WHISPER_RPATH" \
    -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON \
    -DGGML_NATIVE=OFF \
    -DGGML_VULKAN=ON \
    -DGGML_BACKEND_DL=ON \
    -DGGML_CPU_ALL_VARIANTS=ON \
    -DGGML_BACKEND_DIR="$WHISPER_RPATH"
cmake --build build --parallel %{_smp_build_ncpus}
popd

mkdir -p lib
cp build/whisper.cpp/build/bin/libwhisper.so* build/whisper.cpp/build/bin/libparakeet.so* lib/
cp build/whisper.cpp/include/whisper.h build/whisper.cpp/include/parakeet.h lib/
cp build/whisper.cpp/ggml/include/*.h lib/ 2>/dev/null || :
cp build/whisper.cpp/build/bin/libggml*.so* lib/
# The Go bindings link -lggml-cpu, which is a runtime module with GGML_CPU_ALL_VARIANTS
ar rcs lib/libggml-cpu.a

export CGO_ENABLED=1
export C_INCLUDE_PATH=$(pwd)/lib
export LIBRARY_PATH=$(pwd)/lib
export CGO_CFLAGS="-O2 -g -I$(pwd)/lib"
export CGO_LDFLAGS="-L$(pwd)/lib -Wl,-rpath,%{_libdir}/%{name}"
export LD_LIBRARY_PATH=$(pwd)/lib

%global gomodulesmode GO111MODULE=on
export GO_BUILDTAGS="systray gtk"
export GO_LDFLAGS="-X github.com/AshBuk/dabri/v2/internal/version.Version=%{version}"
%gobuild -o %{gobuilddir}/bin/%{name} %{goipath}/cmd/dabri

%install
%go_vendor_license_install -c %{SOURCE2}
install -D -m 0755 %{gobuilddir}/bin/%{name} %{buildroot}%{_bindir}/%{name}

# Install each library once under its full version with a soname symlink.
# Everything links by soname, so the unversioned .so symlinks are not shipped.
install -d %{buildroot}%{_libdir}/%{name}
for lib in lib/libwhisper.so lib/libparakeet.so lib/libggml.so lib/libggml-base.so lib/libggml-cpu-*.so lib/libggml-vulkan.so; do
    [ ! -f "$lib" ] && continue
    base=$(basename "$lib" .so)
    versioned=$(ls -1 ${lib}.*.* 2>/dev/null | grep -E '\.so\.[0-9]+\.[0-9]+' | head -1)
    if [ -n "$versioned" ]; then
        install -m 0755 "$versioned" %{buildroot}%{_libdir}/%{name}/
        versioned_name=$(basename "$versioned")
        major=$(echo "$versioned_name" | sed -E 's/.*\.so\.([0-9]+).*/\1/')
        ln -sf "$versioned_name" %{buildroot}%{_libdir}/%{name}/${base}.so.${major}
    else
        # ggml backend modules have no version
        install -m 0755 "$lib" %{buildroot}%{_libdir}/%{name}/
    fi
done

install -D -m 0644 io.github.ashbuk.dabri.desktop \
    %{buildroot}%{_datadir}/applications/io.github.ashbuk.dabri.desktop
install -D -m 0644 io.github.ashbuk.dabri.appdata.xml \
    %{buildroot}%{_metainfodir}/io.github.ashbuk.dabri.appdata.xml
install -D -m 0644 icons/io.github.ashbuk.dabri.png \
    %{buildroot}%{_datadir}/icons/hicolor/128x128/apps/io.github.ashbuk.dabri.png
install -D -m 0644 icons/io.github.ashbuk.dabri.svg \
    %{buildroot}%{_datadir}/icons/hicolor/scalable/apps/io.github.ashbuk.dabri.svg

install -D -m 0644 README.md %{buildroot}%{_docdir}/%{name}/README.md
install -D -m 0644 docs/Desktop_Environment_Support.md \
    %{buildroot}%{_docdir}/%{name}/Desktop_Environment_Support.md

%check
%go_vendor_license_check -c %{SOURCE2}
desktop-file-validate %{buildroot}%{_datadir}/applications/io.github.ashbuk.dabri.desktop
appstreamcli validate --no-net %{buildroot}%{_metainfodir}/io.github.ashbuk.dabri.appdata.xml
export LD_LIBRARY_PATH=%{buildroot}%{_libdir}/%{name}
%{buildroot}%{_bindir}/%{name} --help 2>&1 | grep -q "dabri"

%files -f %{go_vendor_license_filelist}
%doc %{_docdir}/%{name}/
%{_bindir}/%{name}
%dir %{_libdir}/%{name}
%{_libdir}/%{name}/libwhisper.so*
%{_libdir}/%{name}/libparakeet.so*
%{_libdir}/%{name}/libggml*.so*
%{_datadir}/applications/io.github.ashbuk.dabri.desktop
%{_metainfodir}/io.github.ashbuk.dabri.appdata.xml
%{_datadir}/icons/hicolor/128x128/apps/io.github.ashbuk.dabri.png
%{_datadir}/icons/hicolor/scalable/apps/io.github.ashbuk.dabri.svg

